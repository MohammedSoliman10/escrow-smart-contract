# Which chain the app targets: anvil (default, local) or sepolia (hosted)
VITE_CHAIN=anvil

# Override the active chain's RPC URL (defaults: Anvil → http://127.0.0.1:8545,
# Sepolia → https://ethereum-sepolia-rpc.publicnode.com)
VITE_RPC_URL=

# Override the deployed EscrowFactory address (defaults to the address found in
# broadcast/DeployEscrowFactory.s.sol/<chainId>/run-latest.json by sync-abi)
VITE_FACTORY_ADDRESS=
